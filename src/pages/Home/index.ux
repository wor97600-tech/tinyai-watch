<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #0b0f14;
    flex-direction: column;
    align-items: center;
  }

  /* 聊天和键盘是同一页里的两个视图，用 if 切换。
     手表固件上靠定位撑起来的覆盖层不可靠，会串版甚至卡死。 */
  .view {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
  }

  .header {
    width: 58%;
    padding-top: 42px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .header-text {
    flex: 1;
    flex-direction: column;
  }

  .title {
    font-size: 28px;
    font-weight: bold;
    color: #e6edf3;
  }

  .status {
    margin-top: 2px;
    font-size: 12px;
    color: #7e9ea8;
  }

  .error {
    margin-top: 3px;
    font-size: 11px;
    line-height: 15px;
    color: #ff6b6b;
  }

  .clear-button {
    width: 60px;
    height: 32px;
    border-radius: 16px;
    background-color: #141a22;
    border: 1px solid #253343;
    color: #8b98a5;
    font-size: 12px;
    text-align: center;
  }

  .chat-scroll {
    width: 100%;
    flex: 1;
    min-height: 80px;
  }

  .chat-wrap {
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .chat-list {
    width: 67%;
    padding-top: 6px;
    padding-bottom: 12px;
    flex-direction: column;
  }

  .msg-row {
    width: 100%;
    margin-top: 8px;
    flex-direction: row;
  }

  .msg-row.user {
    justify-content: flex-end;
  }

  .msg-row.ai {
    justify-content: flex-start;
  }

  .bubble {
    width: 54%;
    padding: 10px 12px;
    border-radius: 16px;
    flex-direction: column;
  }

  .bubble-user {
    background-color: #4cc9f0;
    border-bottom-right-radius: 4px;
  }

  .bubble-ai {
    background-color: #141a22;
    border: 1px solid #1e2833;
    border-bottom-left-radius: 4px;
  }

  .msg-text {
    width: 100%;
    font-size: 20px;
    line-height: 28px;
    color: #dbe6f0;
  }

  .msg-text-user {
    color: #061015;
  }

  .msg-text-ai {
    color: #dbe6f0;
  }

  .msg-meta {
    margin-top: 5px;
    font-size: 12px;
    line-height: 16px;
    color: #7e9ea8;
  }

  .input-bar {
    width: 64%;
    padding-top: 8px;
    padding-bottom: 58px;
    flex-direction: row;
    align-items: center;
  }

  .input-wrap {
    flex: 1;
    height: 46px;
    border-radius: 23px;
    background-color: #141a22;
    border: 1px solid #253343;
    padding-left: 12px;
    padding-right: 12px;
    justify-content: center;
    flex-direction: column;
  }

  .chat-input-text {
    width: 100%;
