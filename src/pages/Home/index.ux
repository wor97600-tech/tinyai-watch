    line-height: 28px;
    text-align: center;
    font-size: 13px;
    color: #8b98a5;
  }

  .kb-source-text-on {
    color: #061015;
    font-weight: bold;
  }

  /* ===== 方屏（390x450）独立版式 =====
     designWidth 是 466：所有 px 会按 设备宽度/466 缩放。方屏 390 宽时
     缩放比 0.837，画布变成 466 x 537.7，比圆屏的 466 x 466 纵向多出约 72。
     所以方屏不是把圆屏放大，而是单独排一套：
       - 行宽 88% -> 94%（方屏四角没有圆弧切削，可以铺满）
       - 键高 50 -> 72，键字 26 -> 30
       - 顶部留白 32 -> 24，底部不再空一大块
     两个媒体条件取或：不同固件判定基准（物理像素 / 缩放后画布）不一样，
     aspect-ratio 和 min-height 任一命中都算方屏。 */
  @media (max-aspect-ratio: 9/10), (min-height: 500px) {
    .kb-draft-wrap { width: 60%; height: 30px; margin-top: 24px; }
    .kb-draft { height: 30px; line-height: 30px; font-size: 17px; }
    .kb-typed { width: 76%; height: 36px; }
    .kb-typed-text { height: 36px; line-height: 36px; font-size: 25px; }
    .kb-cand-row { width: 94%; height: 60px; }
    .kb-cand { height: 52px; margin-left: 2px; margin-right: 2px; border-radius: 16px; }
    .kb-cand-text { height: 52px; line-height: 52px; font-size: 25px; }
    .kb-cand-more { width: 62px; height: 52px; margin-left: 2px; margin-right: 2px; border-radius: 16px; }
    .kb-cand-more-text { height: 52px; line-height: 52px; font-size: 16px; }
    .kb-more-panel { width: 94%; margin-top: 12px; }
    .kb-more-row { height: 84px; }
    .kb-more-chip { height: 78px; margin-left: 4px; margin-right: 4px; border-radius: 20px; }
    .kb-more-text { height: 78px; line-height: 78px; font-size: 28px; }
    .kb-more-back { width: 160px; height: 54px; border-radius: 27px; }
    .kb-more-back-text { height: 54px; line-height: 54px; font-size: 17px; }
    .kb-row1 { width: 94%; height: 78px; }
    .kb-row2 { width: 94%; height: 78px; }
    .kb-row3 { width: 94%; height: 78px; }
    .kb-key { height: 72px; margin-left: 2px; margin-right: 2px; border-radius: 18px; }
    .kb-key-text { height: 72px; line-height: 72px; font-size: 30px; }
    .kb-key-small { font-size: 24px; }
    .kb-tools { width: 94%; height: 78px; }
    .kb-tool { height: 72px; border-radius: 18px; }
    .kb-tool-text { height: 72px; line-height: 72px; font-size: 23px; }
    .kb-tool-mode { width: 56px; }
    .kb-tool-page { width: 62px; }
    .kb-tool-del { width: 62px; }
    .kb-tool-send { width: 76px; }
    .kb-close-row { width: 72%; height: 56px; }
    .kb-close { height: 50px; border-radius: 25px; }
    .kb-close-text { height: 50px; line-height: 50px; font-size: 16px; }
    .kb-source { width: 76%; height: 40px; }
    .kb-source-btn { height: 36px; border-radius: 18px; }
    .kb-source-text { height: 36px; line-height: 36px; font-size: 15px; }
  }

  /* 真 input 只负责收字，外壳画在外面的 .input-wrap 上，两套模式长得一模一样 */
  .input-native {
    width: 100%;
    height: 40px;
    background-color: transparent;
    border-width: 0;
