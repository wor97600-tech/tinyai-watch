  }

  .kb-tool-mode {
    width: 46px;
  }

  .kb-tool-page {
    width: 50px;
  }

  .kb-tool-space {
    flex: 1;
  }

  .kb-tool-del {
    width: 50px;
  }

  .kb-tool-send {
    width: 58px;
    background-color: #4cc9f0;
  }

  .kb-tool-text {
    width: 100%;
    height: 46px;
    line-height: 46px;
    text-align: center;
    font-size: 20px;
    color: #dbe6f0;
  }

  .kb-tool-send-text {
